{
  "name": "gladys-loxone",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for the Loxone Miniserver (Gen 1 and Gen 2). Unofficial, not affiliated with Loxone.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0",
    "loxone-ts-api": "^2.1.1",
    "node-ansi-logger": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
